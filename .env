# ---- Kalshi Settings (fill these in) ----
KALSHI_EMAIL="okalright203@gmail.com"
KALSHI_ENV="PROD"  # or "DEMO"

# RSA Credentials
KALSHI_API_KEY_ID="c5e296db-cd30-40ef-80de-bb39a64effc4"

# Prefer repo-relative key paths for portability (resolved relative to PROJECT_K_ROOT / repo root).
KALSHI_PRIVATE_KEY_PATH="key.key"

# ---- Paths (override defaults if needed) ----
# All defaults are repo-relative (portable):
#   DB:           <repo>/data/kalshi.db
#   Training dir: <repo>/data/training
#   Artifacts:    <repo>/artifacts
#
# On a host with a large external drive, you typically keep PROJECT_K_TRAINING_DIR unset
# and make <repo>/data/training a symlink to the external drive.

# Live SQLite DB should stay on internal disk for reliable WAL writes.
# PROJECT_K_DB_PATH="data/kalshi.db"

# Optional (recommended): split OBI writes into a separate DB file to reduce cross-process writer contention.
# If unset, defaults to PROJECT_K_DB_PATH.
# PROJECT_K_OBI_DB_PATH="data/obi.db"

# Training parquet output directory (default: data/training)
# PROJECT_K_TRAINING_DIR="data/training"

# DB read executor worker threads (main.py). Writes/health are single-threaded.
PROJECT_K_DB_READ_WORKERS=4

# Optional: override repo root used for resolving relative paths.
# PROJECT_K_ROOT="/path/to/Project_K"

# ---- Safety Flags ----
# Refuse to use a DB under /Volumes unless explicitly allowed.
#ALLOW_EXTERNAL_DB=1

# If a symlinked training dir points to an unmounted external volume, fail fast by default.
# Set to 1 to fall back to <repo>/data/training_staging.
TRAINING_FALLBACK_LOCAL=0

# turn trading on and off
PROJECT_K_TRADING_ENABLED=0 #0=off 1=on
